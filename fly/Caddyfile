# Caddyfile for the MorphoGenix bench build.
#
# REALITY CHECK (verified by running `expo export --platform web` locally):
# Despite app.json having `experiments.baseUrl = "/demo"`, Expo writes the
# bundle at the FLAT root of dist/, not under dist/demo/. The baseUrl only
# affects the URL paths INSIDE index.html (asset hrefs become /demo/...).
#
# Layout:
#   dist/
#     index.html              <- references /demo/_expo/... and /demo/favicon.ico
#     favicon.ico
#     _expo/static/js/web/index-<hash>.js
#     assets/...
#     +not-found.html
#     _sitemap.html
#
# So our routing must:
#   1. /                  -> 302 /demo/   (so the bare domain works)
#   2. /demo  or /demo/   -> serve dist/index.html
#   3. /demo/<path>       -> strip /demo/, look for <path> in dist/
#                            (so /demo/_expo/... -> dist/_expo/...)
#   4. SPA fallback for client-side routes, but ONLY for navigation requests,
#      never for static asset requests (otherwise the browser parses HTML as
#      JS and throws "Unexpected token '<'").

{
	# Log every request so we can see what's actually being served.
	# Visible via `fly logs -a morphogenix-app`.
	log {
		output stdout
		format console
		level INFO
	}
}

:8080 {
	# Bench-only: ask crawlers to skip us.
	header X-Robots-Tag "noindex, nofollow"
	header Cache-Control "public, max-age=60, must-revalidate"
	encode gzip zstd

	# Per-vhost access log so individual requests show up in fly logs.
	log {
		output stdout
		format console
	}

	# Bare domain -> /demo/ so root URL lands somewhere useful.
	redir / /demo/ 302
	redir /demo /demo/ 302

	# /demo/* -> dist/* (handle_path strips the /demo prefix before matching files)
	handle_path /demo/* {
		root * /srv/dist

		# SPA fallback: if the stripped path is NOT an existing file and is NOT
		# an asset extension, serve index.html so client-side routes resolve.
		# Asset requests for missing files return a real 404 instead of HTML.
		@spa {
			not file
			not path *.js *.css *.map *.json *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp *.woff *.woff2 *.ttf *.otf *.mp4 *.webm
		}
		rewrite @spa /index.html

		file_server
	}

	# Anything outside /demo (favicon-at-root probes, random scanners, etc.) 404s.
	handle {
		respond "Not found - try /demo/" 404
	}
}
